{
 "name": "json-decoding",
 "description": "JinjaValue JSON decoding parity (WorkflowKit semantics). `plain` = Swift fromJSONString/fromJSONData, TS fromJSONString. `legacy` = Swift JSONDecoder with JinjaValue.decodeLegacyTaggedEnvelopes = true (WorkflowValueStorage's unframed path), TS decodeJinjaValueString. `expect` is written in a tagged form ({\"int\": 1}, {\"double\": 1.5}, {\"string\": \"s\"}, {\"bool\": true}, null, {\"array\": [...]}, {\"object\": {...}}) so int and double stay distinct; `error: true` means decoding throws.",
 "cases": [
  {
   "mode": "plain",
   "json": "1.0",
   "expect": {
    "int": 1
   },
   "id": "plain-0"
  },
  {
   "mode": "plain",
   "json": "1e3",
   "expect": {
    "int": 1000
   },
   "id": "plain-1"
  },
  {
   "mode": "plain",
   "json": "-7",
   "expect": {
    "int": -7
   },
   "id": "plain-2"
  },
  {
   "mode": "plain",
   "json": "1.25e-2",
   "expect": {
    "double": 0.0125
   },
   "id": "plain-3"
  },
  {
   "mode": "plain",
   "json": "0.16426666666666667",
   "expect": {
    "double": 0.16426666666666667
   },
   "id": "plain-4"
  },
  {
   "mode": "plain",
   "json": "1e300",
   "expect": {
    "double": 1e+300
   },
   "id": "plain-5"
  },
  {
   "mode": "plain",
   "json": "[1.5, 2.0, {\"n\": 3.0}]",
   "expect": {
    "array": [
     {
      "double": 1.5
     },
     {
      "int": 2
     },
     {
      "object": {
       "n": {
        "int": 3
       }
      }
     }
    ]
   },
   "id": "plain-6"
  },
  {
   "mode": "plain",
   "json": "{\"type\":\"int\",\"value\":7}",
   "expect": {
    "object": {
     "type": {
      "string": "int"
     },
     "value": {
      "int": 7
     }
    }
   },
   "id": "plain-7"
  },
  {
   "mode": "plain",
   "json": "{\"type\":\"string\"}",
   "expect": {
    "object": {
     "type": {
      "string": "string"
     }
    }
   },
   "id": "plain-8"
  },
  {
   "mode": "plain",
   "json": "",
   "error": true,
   "id": "plain-9"
  },
  {
   "mode": "plain",
   "json": "NaN",
   "error": true,
   "id": "plain-10"
  },
  {
   "mode": "plain",
   "json": "Infinity",
   "error": true,
   "id": "plain-11"
  },
  {
   "mode": "plain",
   "json": "1e9999",
   "error": true,
   "id": "plain-12"
  },
  {
   "mode": "plain",
   "json": "[1e9999]",
   "error": true,
   "id": "plain-13"
  },
  {
   "mode": "plain",
   "json": "01",
   "error": true,
   "id": "plain-14"
  },
  {
   "mode": "plain",
   "json": "true false",
   "error": true,
   "id": "plain-15"
  },
  {
   "mode": "plain",
   "json": "{\"a\":}",
   "error": true,
   "id": "plain-16"
  },
  {
   "mode": "legacy",
   "json": "{\"type\":\"null\"}",
   "expect": null,
   "id": "legacy-17"
  },
  {
   "mode": "legacy",
   "json": "{\"type\":\"null\",\"value\":5}",
   "expect": null,
   "id": "legacy-18"
  },
  {
   "mode": "legacy",
   "json": "{\"type\":\"bool\",\"value\":true}",
   "expect": {
    "bool": true
   },
   "id": "legacy-19"
  },
  {
   "mode": "legacy",
   "json": "{\"type\":\"int\",\"value\":7}",
   "expect": {
    "int": 7
   },
   "id": "legacy-20"
  },
  {
   "mode": "legacy",
   "json": "{\"type\":\"int\",\"value\":7.0}",
   "expect": {
    "int": 7
   },
   "id": "legacy-21"
  },
  {
   "mode": "legacy",
   "json": "{\"type\":\"double\",\"value\":5}",
   "expect": {
    "double": 5
   },
   "id": "legacy-22"
  },
  {
   "mode": "legacy",
   "json": "{\"type\":\"double\",\"value\":3.5}",
   "expect": {
    "double": 3.5
   },
   "id": "legacy-23"
  },
  {
   "mode": "legacy",
   "json": "{\"type\":\"string\",\"value\":\"hi\"}",
   "expect": {
    "string": "hi"
   },
   "id": "legacy-24"
  },
  {
   "mode": "legacy",
   "json": "{\"type\":\"array\",\"value\":[{\"type\":\"int\",\"value\":1},2.0]}",
   "expect": {
    "array": [
     {
      "int": 1
     },
     {
      "int": 2
     }
    ]
   },
   "id": "legacy-25"
  },
  {
   "mode": "legacy",
   "json": "{\"type\":\"object\",\"value\":{\"k\":{\"type\":\"string\",\"value\":\"v\"}}}",
   "expect": {
    "object": {
     "k": {
      "string": "v"
     }
    }
   },
   "id": "legacy-26"
  },
  {
   "mode": "legacy",
   "json": "{\"field\":{\"type\":\"string\",\"value\":\"Rush\"}}",
   "expect": {
    "object": {
     "field": {
      "string": "Rush"
     }
    }
   },
   "id": "legacy-27"
  },
  {
   "mode": "legacy",
   "json": "{\"type\":\"widget\",\"value\":3}",
   "expect": {
    "object": {
     "type": {
      "string": "widget"
     },
     "value": {
      "int": 3
     }
    }
   },
   "id": "legacy-28"
  },
  {
   "mode": "legacy",
   "json": "{\"type\":\"int\",\"value\":5,\"label\":\"x\"}",
   "expect": {
    "object": {
     "type": {
      "string": "int"
     },
     "value": {
      "int": 5
     },
     "label": {
      "string": "x"
     }
    }
   },
   "id": "legacy-29"
  },
  {
   "mode": "legacy",
   "json": "{\"type\":5}",
   "expect": {
    "object": {
     "type": {
      "int": 5
     }
    }
   },
   "id": "legacy-30"
  },
  {
   "mode": "legacy",
   "json": "5.0",
   "expect": {
    "int": 5
   },
   "id": "legacy-31"
  },
  {
   "mode": "legacy",
   "json": "{\"type\":\"string\"}",
   "error": true,
   "id": "legacy-32"
  },
  {
   "mode": "legacy",
   "json": "{\"type\":\"int\"}",
   "error": true,
   "id": "legacy-33"
  },
  {
   "mode": "legacy",
   "json": "{\"type\":\"int\",\"value\":7.5}",
   "error": true,
   "id": "legacy-34"
  },
  {
   "mode": "legacy",
   "json": "{\"type\":\"int\",\"value\":\"7\"}",
   "error": true,
   "id": "legacy-35"
  },
  {
   "mode": "legacy",
   "json": "{\"type\":\"int\",\"value\":null}",
   "error": true,
   "id": "legacy-36"
  },
  {
   "mode": "legacy",
   "json": "{\"type\":\"bool\",\"value\":1}",
   "error": true,
   "id": "legacy-37"
  },
  {
   "mode": "legacy",
   "json": "{\"type\":\"double\",\"value\":\"1\"}",
   "error": true,
   "id": "legacy-38"
  },
  {
   "mode": "legacy",
   "json": "{\"type\":\"string\",\"value\":5}",
   "error": true,
   "id": "legacy-39"
  },
  {
   "mode": "legacy",
   "json": "{\"type\":\"array\",\"value\":{}}",
   "error": true,
   "id": "legacy-40"
  },
  {
   "mode": "legacy",
   "json": "{\"type\":\"object\",\"value\":[]}",
   "error": true,
   "id": "legacy-41"
  },
  {
   "mode": "legacy",
   "json": "{\"type\":\"date\",\"value\":\"2026-10-01\"}",
   "error": true,
   "id": "legacy-42"
  },
  {
   "mode": "legacy",
   "json": "{\"type\":\"object\",\"value\":{\"k\":{\"type\":\"int\"}}}",
   "error": true,
   "id": "legacy-43"
  }
 ]
}
